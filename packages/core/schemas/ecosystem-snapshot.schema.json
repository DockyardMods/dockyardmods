{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"version": {
			"type": "integer",
			"const": 1
		},
		"currentGameVersionId": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"$schema": {
			"type": "string",
			"const": "https://raw.githubusercontent.com/DockyardMods/dockyardmods/main/packages/core/schemas/ecosystem-snapshot.schema.json"
		},
		"mods": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"name": {
						"type": "string",
						"minLength": 1
					},
					"summary": {
						"type": "string",
						"minLength": 1
					},
					"version": {
						"type": "string",
						"minLength": 1
					},
					"authors": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"gameVersionId": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					},
					"packages": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"url": {
									"type": "string",
									"minLength": 1,
									"format": "uri"
								},
								"sha256": {
									"type": "string",
									"pattern": "^[A-Fa-f0-9]{64}$"
								}
							},
							"required": ["url", "sha256"],
							"additionalProperties": false,
							"title": "Dockyard Mod Package"
						}
					},
					"description": {
						"type": "string",
						"minLength": 1
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"changelog": {
						"type": "string",
						"minLength": 1
					},
					"dependencies": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
								},
								"version": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": ["id", "version"],
							"additionalProperties": false,
							"title": "Dockyard Mod Dependency"
						}
					},
					"license": {
						"type": "string",
						"minLength": 1
					},
					"repo": {
						"type": "string",
						"pattern": "^https:\\/\\/github\\.com\\/DockyardMods\\/[A-Za-z0-9_.-]+$"
					},
					"ref": {
						"type": "string",
						"pattern": "^[A-Fa-f0-9]{40}$"
					},
					"manifestPath": {
						"type": "string",
						"minLength": 1
					},
					"manifestUrl": {
						"type": "string",
						"format": "uri"
					},
					"media": {
						"type": "object",
						"properties": {
							"iconUrl": {
								"type": "string",
								"format": "uri"
							},
							"items": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"enum": ["image", "video"]
										},
										"alt": {
											"type": "string",
											"minLength": 1
										},
										"url": {
											"type": "string",
											"format": "uri"
										},
										"thumbnailUrl": {
											"type": "string",
											"format": "uri"
										}
									},
									"required": ["type", "url"],
									"additionalProperties": false,
									"title": "Resolved Mod Media Item"
								}
							}
						},
						"required": ["iconUrl"],
						"additionalProperties": false,
						"title": "Resolved Mod Media"
					},
					"certification": {
						"type": "object",
						"properties": {
							"expiresAt": {
								"type": "string",
								"format": "date",
								"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
							}
						},
						"required": ["expiresAt"],
						"additionalProperties": false,
						"title": "Certification"
					}
				},
				"required": [
					"id",
					"name",
					"summary",
					"version",
					"authors",
					"gameVersionId",
					"packages",
					"repo",
					"ref",
					"manifestPath",
					"manifestUrl",
					"media"
				],
				"additionalProperties": false,
				"title": "Resolved Mod"
			}
		}
	},
	"required": ["version", "currentGameVersionId", "mods"],
	"additionalProperties": false,
	"title": "Resolved Dockyard Ecosystem"
}
