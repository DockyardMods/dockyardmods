{
	"name": "dockyardmods",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=26.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev:web": "pnpm --filter @dockyardmods/website dev",
		"build:web": "pnpm --filter @dockyardmods/website build",
		"generate:schemas": "pnpm --filter=@dockyardmods/scripts generate:schemas",
		"check:web": "pnpm --filter @dockyardmods/website check",
		"check:ui": "pnpm --filter @dockyardmods/ui check",
		"check:core": "pnpm --filter @dockyardmods/core check",
		"check:scripts": "pnpm --filter @dockyardmods/scripts check",
		"lint:web": "eslint --fix apps/website",
		"lint:ui": "eslint --fix packages/ui",
		"lint:core": "eslint --fix packages/core",
		"lint:scripts": "eslint --fix packages/scripts",
		"fmt:web": "prettier --write apps/website",
		"fmt:ui": "prettier --write packages/ui",
		"fmt:core": "prettier --write packages/core",
		"fmt:scripts": "prettier --write packages/scripts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0"
	}
}
